; Engine configuration file.
; Edited by Codex for Zero Net Trace.

config_version=5

[application]

config/name="零网寻踪"
config/version="0.1.0-mvp"
run/main_scene="res://scenes/os/main.tscn"

[autoload]

DataRepository="*res://scripts/engine/data_repository.gd"
CaseRuntime="*res://scripts/engine/case_runtime.gd"
SaveService="*res://scripts/engine/save_service.gd"
EventBus="*res://scripts/engine/event_bus.gd"
AudioDirector="*res://scripts/engine/audio_director.gd"
HorrorDirector="*res://scripts/engine/horror_director.gd"

[display]

[display/window]
size/viewport_width=1600
size/viewport_height=900
size/window_width_override=1280
size/window_height_override=720
size/mode=4
stretch/mode="canvas_items"
handheld/orientation=1

[display/window/vsync]

vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

[debug]

file_logging/enable_file_logging=true
file_logging/log_path="user://zero_net_trace.log"

[audio]

driver/enable_input=false
