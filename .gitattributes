* text=auto

# Godot and project sources use stable LF endings.
*.gd text eol=lf
*.godot text eol=lf
*.gdshader text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.md text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.uid text eol=lf

# Binary game assets must never be line-ending normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ttf binary
*.otf binary
*.wav binary
*.ogg binary
*.mp3 binary
*.exe binary
*.pck binary
*.zip binary
*.7z binary
